NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/connectcraft
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
ADMIN_SECRET_KEY=replace-with-a-strong-admin-registration-key
SUPER_ADMIN_KEY=replace-with-a-strong-one-time-bootstrap-key

# Enables Cloudinary-backed uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Enables email delivery through Google Apps Script.
GOOGLE_APPS_SCRIPT_URL=
